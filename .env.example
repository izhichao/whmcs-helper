# --- 监控配置 ---
# STOCKVPS_URLS: 监控商品链接，多个链接用英文分号 (;) 分开
# STOCKVPS_INTERVAL: 监控频率，单位秒，默认一分钟一次 (60)
# STOCKVPS_LOGS: 是否打印详细运行日志 (true/false)
STOCKVPS_URLS=""
STOCKVPS_INTERVAL=60
STOCKVPS_LOGS=true

# --- 代理配置 (选填) ---
# STOCKVPS_PROXY: 代理地址，支持 http/https/socks5 等，如 socks5://127.0.0.1:7890 (选填)
# STOCKVPS_FS_PROXY: FlareSolverr 服务的代理地址，如未配置则默认回退到 STOCKVPS_PROXY (选填)
# STOCKVPS_FS_URL: FlareSolverr 服务的 API 地址，例如: http://localhost:8191/v1 (选填)
STOCKVPS_PROXY=""
STOCKVPS_FS_PROXY=""
STOCKVPS_FS_URL=""

# --- 推送通知配置 (选填) ---

# 0. 随机一言 (随机句子)
# HITOKOTO: 是否在通知底部附带一句随机句子 (true/false)
HITOKOTO="false"

# 1. Server酱 (https://sct.ftqq.com)
# PUSH_KEY: 微信推送服务的 Key
PUSH_KEY=""

# 2. BARK (iOS 专属推送)
# BARK_PUSH: BARK 的设备密钥/服务器地址 (例：123 或 https://api.day.app/123)
# BARK_ICON: 自定义推送图标 URL
# BARK_SOUND: 自定义推送声音
# BARK_GROUP: 推送消息分组 (默认 "QingLong")
# BARK_LEVEL: 推送时效性 (默认 "active")
# BARK_ARCHIVE: 是否对推送进行历史存档
# BARK_URL: 推送点击跳转 URL
BARK_PUSH=""
BARK_ICON="https://qn.whyour.cn/logo.png"
BARK_SOUND=""
BARK_GROUP="QingLong"
BARK_LEVEL="active"
BARK_ARCHIVE=""
BARK_URL=""

# 3. Telegram 机器人
# TG_BOT_TOKEN: 申请到的机器人 Token
# TG_USER_ID: 接收通知的个人或群组数字 ID
# TG_PROXY_HOST: HTTP 代理服务器地址 (例如：127.0.0.1，可选)
# TG_PROXY_PORT: HTTP 代理服务器端口 (例如：1080，可选)
# TG_PROXY_AUTH: 代理认证用户名密码 (可选)
# TG_API_HOST: 反向代理 API 地址 (例如：aaa.bbb.ccc，可选)
TG_BOT_TOKEN=""
TG_USER_ID=""
TG_PROXY_HOST=""
TG_PROXY_PORT=""
TG_PROXY_AUTH=""
TG_API_HOST=""

# 4. 钉钉群机器人
# DD_BOT_TOKEN: 机器人 webhook 链接中 access_token= 后面的内容
# DD_BOT_SECRET: 安全设置中的签名密钥
DD_BOT_TOKEN=""
DD_BOT_SECRET=""

# 5. 企业微信群机器人
# QYWX_ORIGIN: 企业微信 API 代理地址 (不配置默认使用官方 API)
# QYWX_KEY: 机器人 webhook 链接中 key= 后面的内容
QYWX_ORIGIN=""
QYWX_KEY=""

# 6. 企业微信应用消息 (推送至个人)
# QYWX_AM: 依次填入 corpid,corpsecret,touser,agentid,msgtype 并用英文逗号分隔
# - touser: 多个成员用 | 隔开，或者填写 @all 代表所有人
# - msgtype: 选填。0为卡片消息，1为纯文本消息，不填默认纯文本，或者填写素材库图片ID进行图文消息推送
QYWX_AM=""

# 7. iGot 聚合推送
# IGOT_PUSH_KEY: iGot 推送的 Key (例如：https://push.hellyw.com/XXX 中的 XXX)
IGOT_PUSH_KEY=""

# 8. Push Plus (http://www.pushplus.plus)
# PUSH_PLUS_TOKEN: 微信扫码登录后获取的用户令牌
# PUSH_PLUS_USER: 群组编码 (可选，多对多推送时填写)
# PUSH_PLUS_TEMPLATE: 发送格式 (支持 html, txt, json, markdown，默认 html)
# PUSH_PLUS_CHANNEL: 发送渠道 (支持 wechat, webhook, cp, mail, sms，默认 wechat)
# PUSH_PLUS_WEBHOOK: webhook 编码
# PUSH_PLUS_CALLBACKURL: 发送结果回调接口
# PUSH_PLUS_TO: 好友/接收端令牌
PUSH_PLUS_TOKEN=""
PUSH_PLUS_USER=""
PUSH_PLUS_TEMPLATE="html"
PUSH_PLUS_CHANNEL="wechat"
PUSH_PLUS_WEBHOOK=""
PUSH_PLUS_CALLBACKURL=""
PUSH_PLUS_TO=""

# 9. 微加机器人 (http://www.weplusbot.com)
# WE_PLUS_BOT_TOKEN: 微加用户的接口 Token
# WE_PLUS_BOT_RECEIVER: 接收消息的群编码或个人 ID (不填默认发给自己)
# WE_PLUS_BOT_VERSION: 调用版本 (专业版: pro，个人版: personal，默认 pro)
WE_PLUS_BOT_TOKEN=""
WE_PLUS_BOT_RECEIVER=""
WE_PLUS_BOT_VERSION="pro"

# 10. go-cqhttp (QQ 推送)
# GOBOT_URL: 推送 API 链接 (例: http://127.0.0.1/send_private_msg 或 send_group_msg)
# GOBOT_TOKEN: 安全校验 Access Token
# GOBOT_QQ: 接收参数 (个人: user_id=QQ号，群: group_id=群号)
GOBOT_URL=""
GOBOT_TOKEN=""
GOBOT_QQ=""

# 11. Gotify 推送
# GOTIFY_URL: 自建 Gotify 服务器地址 (例：https://push.example.de:8080)
# GOTIFY_TOKEN: 应用安全 Token
# GOTIFY_PRIORITY: 推送优先级 (默认 0)
GOTIFY_URL=""
GOTIFY_TOKEN=""
GOTIFY_PRIORITY=0

# 12. PushDeer (国内免代理推送)
# DEER_KEY: 设备的 PUSHDEER_KEY
# DEER_URL: 自建 PushDeer 服务 API 地址 (可选，默认使用官方)
DEER_KEY=""
DEER_URL=""

# 13. Synology Chat (群晖 Chat)
# CHAT_URL: 聊天机器人 Webhook 链接前缀 (含 http, IP 和端口)
# CHAT_TOKEN: Webhook 的 Token 部分 (即 token= 后面的内容)
CHAT_URL=""
CHAT_TOKEN=""

# 14. 智能微秘书 (微信助手)
# AIBOTK_KEY: 智能微秘书个人中心的 apikey
# AIBOTK_TYPE: 发送目标类型 (room: 群聊，contact: 好友)
# AIBOTK_NAME: 接收群名或好友昵称 (需与 AIBOTK_TYPE 对应)
AIBOTK_KEY=""
AIBOTK_TYPE=""
AIBOTK_NAME=""

# 15. CHRONOCAT (QQ 新版协议推送)
# CHRONOCAT_URL: 服务连接地址 (例: http://127.0.0.1:16530)
# CHRONOCAT_QQ: 接收参数 (个人: user_id=QQ号，群: group_id=群号，多个用分号分隔)
# CHRONOCAT_TOKEN: 访问令牌
CHRONOCAT_URL=""
CHRONOCAT_QQ=""
CHRONOCAT_TOKEN=""

# 16. 邮件通知 (SMTP)
# SMTP_SERVICE: 邮箱服务商名称 (如 126, 163, Gmail, QQ 等)
# SMTP_SERVER: 发信 SMTP 服务器及端口 (例如: smtp.exmail.qq.com:465)
# SMTP_SSL: 是否开启 SSL (true/false)
# SMTP_EMAIL: 发件箱邮箱地址
# SMTP_PASSWORD: 发件箱授权码或登录密码
# SMTP_NAME: 发件人姓名 (可自定义)
# SMTP_EMAIL_TO: 收件箱，多个用英文分号 ; 分隔 (不填默认发给发信箱)
# SMTP_TO: 收件箱，兼容老版参数 (不填默认发给发信箱)
SMTP_SERVICE=""
SMTP_SERVER=""
SMTP_SSL=""
SMTP_EMAIL=""
SMTP_PASSWORD=""
SMTP_NAME=""
SMTP_EMAIL_TO=""
SMTP_TO=""

# 17. PushMe 酱
# PUSHME_KEY: PushMe 官方生成的 key
# PUSHME_URL: 自建服务的 API 地址 (可选，不填默认官方接口)
PUSHME_KEY=""
PUSHME_URL=""

# 18. 飞书机器人
# FSKEY: 飞书自定义机器人的 Webhook 密钥 (FSKEY)
# FSSECRET: 飞书安全设置中的签名校验密钥 (可选)
FSKEY=""
FSSECRET=""

# 19. Qmsg酱 (QQ 通知)
# QMSG_KEY: Qmsg 酱的 KEY
# QMSG_TYPE: 推送类型 (send 为私聊，group 为群聊)
QMSG_KEY=""
QMSG_TYPE=""

# 20. Ntfy 通知
# NTFY_URL: Ntfy 地址 (默认 https://ntfy.sh)
# NTFY_TOPIC: 订阅的主题 topic
# NTFY_PRIORITY: 推送优先级 (默认 3)
# NTFY_TOKEN: 安全认证 Token (可选)
# NTFY_USERNAME: 认证用户名 (可选)
# NTFY_PASSWORD: 认证密码 (可选)
# NTFY_ACTIONS: 自定义点击按钮行为动作 (可选)
NTFY_URL=""
NTFY_TOPIC=""
NTFY_PRIORITY="3"
NTFY_TOKEN=""
NTFY_USERNAME=""
NTFY_PASSWORD=""
NTFY_ACTIONS=""

# 21. WxPusher (微信免费推送)
# WXPUSHER_APP_TOKEN: 开发者 appToken
# WXPUSHER_TOPIC_IDS: 主题 ID (多个用英文分号 ; 分隔)
# WXPUSHER_UIDS: 用户 ID (多个用英文分号 ; 分隔)
WXPUSHER_APP_TOKEN=""
WXPUSHER_TOPIC_IDS=""
WXPUSHER_UIDS=""

# 22. 自定义 Webhook 通知
# WEBHOOK_URL: 回调 API 地址
# WEBHOOK_BODY: 请求体，支持使用 $'\n' 进行换行拼接
# WEBHOOK_HEADERS: 请求头，支持使用 $'\n' 进行换行拼接
# WEBHOOK_METHOD: 请求方法 (GET/POST/PUT)
# WEBHOOK_CONTENT_TYPE: Content-Type 头
WEBHOOK_URL=""
WEBHOOK_BODY=""
WEBHOOK_HEADERS=""
WEBHOOK_METHOD=""
WEBHOOK_CONTENT_TYPE=""

# 23. OpeniLink
# OPENILINK_APP_TOKEN: OpeniLink Hub 后台分配的 App Token
# OPENILINK_HUB_URL: Hub 地址，自建时填写，默认使用官方 https://hub.openilink.com
# OPENILINK_CONTEXT_TOKEN: 标识消息会话上下文的 Token
OPENILINK_APP_TOKEN=""
OPENILINK_HUB_URL=""
OPENILINK_CONTEXT_TOKEN=""